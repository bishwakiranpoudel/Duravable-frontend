# Google Gemini API key (required for chat and doctor search).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Upstash Redis for conversation persistence (serverless-friendly).
# If unset, conversations are stored in-memory.
# Get credentials at https://console.upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
